{
  "graphId": "pb-sme-letter",
  "version": 1,
  "taskId": "playbook:sme_letter",
  "goal": "Run the sme_letter playbook (v1) as a graph, doing exactly what the old runner does.",
  "successMetric": {
    "name": "run finished",
    "target": 1,
    "unit": "runs",
    "measuredBy": "draft_approved"
  },
  "stopConditions": ["budget reached", "rejected by Archie", "outreach not allowed"],
  "budgetGbp": 0.4,
  "state": {
    "entity_ref": {
      "type": "string",
      "untrusted": false
    },
    "outreach_allowed": {
      "type": "boolean",
      "untrusted": false
    },
    "letter_brief": {
      "type": "json",
      "untrusted": false
    },
    "letter_draft": {
      "type": "json",
      "untrusted": false
    },
    "check_feedback": {
      "type": "string",
      "untrusted": false
    },
    "pass_or_fail": {
      "type": "json",
      "untrusted": false
    },
    "check_verdict": {
      "type": "enum",
      "enumValues": ["pass", "fail"],
      "untrusted": false
    },
    "approved": {
      "type": "boolean",
      "untrusted": false
    },
    "print_ready": {
      "type": "json",
      "untrusted": false
    }
  },
  "inputs": ["entity_ref", "check_feedback"],
  "nodes": [
    {
      "id": "research",
      "kind": "role",
      "ref": "researcher",
      "reads": [],
      "writes": ["letter_brief"],
      "config": {
        "playbook": "sme_letter",
        "step": "research"
      },
      "budget": {
        "maxCostGbp": 0.066666,
        "maxDurationS": 600
      }
    },
    {
      "id": "draft",
      "kind": "role",
      "ref": "writer",
      "reads": ["letter_brief", "check_feedback"],
      "writes": ["letter_draft"],
      "config": {
        "playbook": "sme_letter",
        "step": "draft"
      },
      "budget": {
        "maxCostGbp": 0.066666,
        "maxDurationS": 600
      }
    },
    {
      "id": "check",
      "kind": "role",
      "ref": "checker",
      "reads": ["letter_brief", "letter_draft"],
      "writes": ["pass_or_fail", "check_verdict", "check_feedback"],
      "config": {
        "playbook": "sme_letter",
        "step": "check"
      },
      "budget": {
        "maxCostGbp": 0.066666,
        "maxDurationS": 600
      }
    },
    {
      "id": "check_review",
      "kind": "approval",
      "ref": "archie",
      "reads": ["letter_brief", "letter_draft", "pass_or_fail"],
      "writes": ["approved", "letter_draft"],
      "config": {
        "kind": "check_failed",
        "playbook": "sme_letter"
      },
      "budget": {
        "maxCostGbp": 0,
        "maxDurationS": 604800
      }
    },
    {
      "id": "suppression",
      "kind": "function",
      "ref": "suppression_check",
      "reads": ["entity_ref"],
      "writes": ["outreach_allowed"],
      "budget": {
        "maxCostGbp": 0,
        "maxDurationS": 60
      }
    },
    {
      "id": "cooldown",
      "kind": "function",
      "ref": "contact_cooldown",
      "reads": ["entity_ref"],
      "writes": ["outreach_allowed"],
      "budget": {
        "maxCostGbp": 0,
        "maxDurationS": 60
      }
    },
    {
      "id": "prepare",
      "kind": "role",
      "ref": "writer",
      "reads": ["letter_brief", "letter_draft", "pass_or_fail"],
      "writes": ["print_ready"],
      "config": {
        "playbook": "sme_letter",
        "step": "prepare"
      },
      "budget": {
        "maxCostGbp": 0.066666,
        "maxDurationS": 600
      }
    },
    {
      "id": "print_batch",
      "kind": "approval",
      "ref": "archie",
      "reads": ["letter_brief", "letter_draft", "pass_or_fail", "print_ready"],
      "writes": ["approved", "letter_draft", "print_ready"],
      "config": {
        "kind": "gate",
        "playbook": "sme_letter"
      },
      "budget": {
        "maxCostGbp": 0,
        "maxDurationS": 604800
      }
    }
  ],
  "edges": [
    {
      "from": "research",
      "to": "draft"
    },
    {
      "from": "draft",
      "to": "check"
    },
    {
      "from": "check",
      "to": "draft",
      "when": {
        "key": "check_verdict",
        "op": "eq",
        "value": "fail"
      },
      "loop": {
        "maxIterations": 1
      }
    },
    {
      "from": "check",
      "to": "check_review",
      "when": {
        "key": "check_verdict",
        "op": "eq",
        "value": "fail"
      }
    },
    {
      "from": "check",
      "to": "suppression",
      "when": {
        "key": "check_verdict",
        "op": "eq",
        "value": "pass"
      }
    },
    {
      "from": "suppression",
      "to": "cooldown",
      "when": {
        "key": "outreach_allowed",
        "op": "eq",
        "value": true
      }
    },
    {
      "from": "cooldown",
      "to": "prepare",
      "when": {
        "key": "outreach_allowed",
        "op": "eq",
        "value": true
      }
    },
    {
      "from": "prepare",
      "to": "print_batch"
    }
  ],
  "entry": "research",
  "exits": ["check_review", "print_batch"],
  "planner": {
    "model": "none",
    "promptVersion": "converted",
    "rationale": "Converted mechanically from playbooks/sme_letter/SKILL.md v1 at L0.",
    "assumptions": []
  }
}
