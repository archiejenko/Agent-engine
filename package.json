{
  "name": "agent-engine",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm db:migrate && pnpm --parallel --filter @ae/api --filter @ae/dashboard dev",
    "db:migrate": "tsx scripts/migrate.ts",
    "typecheck": "tsc -p tsconfig.json && pnpm -r --parallel typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "build:dashboard": "pnpm --filter @ae/dashboard build",
    "cf:deploy": "pnpm build:dashboard && pnpm --filter @ae/api run cf:deploy",
    "sources:download": "tsx scripts/download-sources.ts",
    "ingest:universe": "tsx scripts/ingest-universe.ts",
    "ingest:accounts": "tsx scripts/ingest-accounts.ts",
    "ingest:companies": "tsx scripts/ingest-companies.ts",
    "gate:phase1": "tsx scripts/gate-phase1.ts",
    "rehearse": "tsx scripts/rehearse.ts",
    "rollback": "tsx scripts/rollback.ts",
    "gate:phase2": "tsx scripts/gate-phase2.ts",
    "runner:tick": "pnpm --filter @ae/agent-runner tick",
    "weights": "tsx scripts/weights.ts",
    "digests": "tsx scripts/digests.ts",
    "nightly": "tsx scripts/nightly.ts",
    "gate:phase3": "tsx scripts/gate-phase3.ts",
    "gate:phase4": "tsx scripts/gate-phase4.ts"
  },
  "devDependencies": {
    "@ae/storage": "workspace:*",
    "@biomejs/biome": "2.6.6",
    "@types/node": "^22.19.0",
    "miniflare": "4.20260730.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.12",
    "@ae/config": "workspace:*",
    "@ae/verification": "workspace:*",
    "@ae/agent-runner": "workspace:*",
    "@ae/infra": "workspace:*",
    "@ae/opportunity": "workspace:*",
    "@ae/ports": "workspace:*",
    "@ae/contracts": "workspace:*",
    "@ae/products": "workspace:*",
    "@ae/api": "workspace:*"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "workerd",
      "sharp"
    ]
  }
}
