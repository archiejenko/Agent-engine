{
  "name": "agent-engine",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm db:migrate && pnpm --parallel --filter @ae/api --filter @ae/dashboard dev",
    "db:migrate": "tsx scripts/migrate.ts",
    "typecheck": "tsc -p tsconfig.json && pnpm -r --parallel typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "build:dashboard": "pnpm --filter @ae/dashboard build",
    "cf:deploy": "pnpm build:dashboard && pnpm --filter @ae/api run cf:deploy"
  },
  "devDependencies": {
    "@ae/storage": "workspace:*",
    "@biomejs/biome": "2.6.6",
    "@types/node": "^22.19.0",
    "miniflare": "4.20260730.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "workerd",
      "sharp"
    ]
  }
}
