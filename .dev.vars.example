# Copy to .dev.vars and fill in. .dev.vars is git-ignored. Never commit real values.
# Phase 1: Companies House REST API key (developer.company-information.service.gov.uk)
CH_API_KEY=
# Cloudflare Access (only needed to test Access validation locally; leave blank for local dev)
ACCESS_TEAM_DOMAIN=
ACCESS_POLICY_AUD=
# Website extraction comparison / Gemini 4 Hydrogen (only when models.json website_extractor.model is
# "gemini-4-hydrogen", or to run `pnpm compare:extractors`). Gemini key from aistudio.google.com.
GEMINI_API_KEY=
# Claude API key: the extractor's fallback and the comparison's Opus side.
ANTHROPIC_API_KEY=
