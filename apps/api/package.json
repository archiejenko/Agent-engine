{
  "name": "@ae/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/node.ts",
    "dev:worker": "wrangler dev",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.worker.json",
    "cf-typegen": "wrangler types --strict-vars=false",
    "cf:deploy": "wrangler deploy && wrangler d1 migrations apply DB --remote"
  },
  "dependencies": {
    "@ae/agent-runner": "workspace:*",
    "@ae/config": "workspace:*",
    "@ae/contracts": "workspace:*",
    "@ae/infra": "workspace:*",
    "@ae/opportunity": "workspace:*",
    "@ae/products": "workspace:*",
    "@ae/storage": "workspace:*",
    "@ae/verification": "workspace:*",
    "@hono/node-server": "2.1.6",
    "@x402/core": "2.30.0",
    "@x402/evm": "2.30.0",
    "@x402/hono": "2.30.0",
    "hono": "4.13.16",
    "jose": "6.2.15",
    "pdf-lib": "1.17.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "wrangler": "4.158.0"
  }
}
