{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "agent-engine",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-01",
  "workers_dev": true,
  // Version/preview URLs off until Access covers them too.
  "preview_urls": false,
  "observability": { "enabled": true },
  "upload_source_maps": true,
  "assets": {
    "directory": "../dashboard/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/x402/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "agent-engine",
      "migrations_dir": "../../packages/storage/migrations"
    }
  ],
  // Not secret. Filled in after Access is enabled (see docs/runbooks/deploy.md).
  // While empty, the Worker refuses every /api request (fails closed).
  "vars": {
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_POLICY_AUD": ""
  }
}
