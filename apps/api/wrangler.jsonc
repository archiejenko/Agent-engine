{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "agent-engine",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-01",
  // The official x402 middleware uses Node's Buffer.
  "compatibility_flags": ["nodejs_compat"],
  // The dashboard lives on engine.ejtech.co.uk, which the ejtech.co.uk Access app covers.
  // workers.dev is off: that hostname sits outside the ejtech.co.uk Access app.
  "workers_dev": false,
  "routes": [{ "pattern": "engine.ejtech.co.uk", "custom_domain": true }],
  // Version/preview URLs off until Access covers them too.
  "preview_urls": false,
  "observability": { "enabled": true },
  "upload_source_maps": true,
  "assets": {
    "directory": "../dashboard/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/x402/*",
      "/public/*",
      "/webhooks/*",
      "/demo/*",
      "/stop/*",
      "/claim/*",
      "/s/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "agent-engine",
      // Created 2026-11-24 (region WEUR). Not secret: it names the database, it grants nothing.
      "database_id": "2714afcd-59c7-4ee1-a6ea-5251a0b08fb4",
      "migrations_dir": "../../packages/storage/migrations"
    }
  ],
  // v2 runtime (decision D3). The cron enqueues jobs; the queue consumer runs them; failures retry 3
  // times then land on the dead-letter queue, whose consumer records them and raises an alert.
  "triggers": { "crons": ["*/5 * * * *"] },
  "queues": {
    "producers": [{ "binding": "JOBS", "queue": "ae-jobs" }],
    "consumers": [
      {
        "queue": "ae-jobs",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "retry_delay": 60,
        "dead_letter_queue": "ae-jobs-dlq"
      },
      { "queue": "ae-jobs-dlq", "max_batch_size": 10, "max_retries": 10 }
    ]
  },
  // The Companies House change feed: one Durable Object holds the feed position (strongly consistent).
  "durable_objects": {
    "bindings": [
      { "name": "CHANGE_FEED", "class_name": "ChangeFeed" },
      // Hard budgets: one object holds every reservation, so parallel work can't overspend a cap.
      { "name": "BUDGET", "class_name": "BudgetObject" },
      // Data layer step 1: one object per graph run holds its node runs and state; emptied at the end.
      { "name": "RUN_STATE", "class_name": "RunState" }
    ]
  },
  // Closed graph runs are archived here (one object per run). No id: wrangler creates the bucket at
  // the next deploy. Never the agent-house-files bucket.
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "agent-engine-files" }],
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ChangeFeed"] },
    { "tag": "v2", "new_sqlite_classes": ["BudgetObject"] },
    { "tag": "v3", "new_sqlite_classes": ["RunState"] }
  ],
  // Multi-step work over time (fulfilment, experiments, weekly loops) runs as Cloudflare Workflows.
  "workflows": [
    { "name": "ae-engine", "binding": "ENGINE", "class_name": "EngineWorkflow" },
    // Task graph layer (G2): one interpreter for every graph. Used only when GRAPH_ENGINE_ENABLED is "1".
    { "name": "ae-graph", "binding": "GRAPH", "class_name": "GraphRunWorkflow" }
  ],
  // Not secret. Filled in after Access is enabled (see docs/runbooks/deploy.md).
  // While empty, the Worker refuses every /api request (fails closed).
  "vars": {
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_POLICY_AUD": "",
    // "1" (with the ANTHROPIC_API_KEY secret) switches the runtime from the fake model to Claude.
    "MODEL_LIVE": "",
    // "1" runs sme_outreach on the graph runtime (GraphRunWorkflow); empty keeps the old runner.
    "GRAPH_ENGINE_ENABLED": ""
  }
}
