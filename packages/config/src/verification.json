{
  "triangulation": {
    "clear_margin": 0.15
  },
  "sanity": {
    "max_employees": 500000,
    "revenue_per_employee_gbp": {
      "min": 5000,
      "max": 5000000
    }
  },
  "resolution": {
    "weights": {
      "name": 0.6,
      "postcode": 0.3,
      "domain": 0.1
    },
    "auto_match": 0.9,
    "adjudicate": 0.6
  },
  "drift": {
    "baseline_days": 7,
    "min_baseline_days": 3,
    "volume_ratio_min": 0.5,
    "volume_ratio_max": 3.0,
    "null_rate_increase_max": 0.2,
    "match_rate_drop_max": 0.1,
    "mean_relative_change_max": 0.5,
    "min_complete_runs": 3
  },
  "golden": {
    "target_companies": 150,
    "fields": [
      "company_status",
      "employees_average",
      "registered_office_postcode",
      "website_copyright_year",
      "trading_address_postcode"
    ]
  },
  "reverify": {
    "daily_call_budget": 2000,
    "calls_per_company": 4.2,
    "request_weight": 3,
    "opportunity_weight": 2
  },
  "website_extraction": {
    "_note": "Per-page text limit before the model sees a page. Calls average ~8,500 input tokens over up to 3 pages, about 2,600 tokens a page after ~600 tokens of prompt. 6,000 tokens a page (~2.3x the average) lets normal pages through untouched and cuts only huge ones; the worst case is ~18,600 input tokens a call. Tokens are estimated as characters / chars_per_token.",
    "page_token_budget": 6000,
    "chars_per_token": 4
  }
}
